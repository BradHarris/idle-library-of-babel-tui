{
  "name": "library-of-babel-idle",
  "version": "0.1.0",
  "description": "A terminal-based idle/incremental game inspired by Borges' Library of Babel",
  "type": "module",
  "main": "src/index.tsx",
  "scripts": {
    "start": "tsx src/index.tsx",
    "dev": "tsx --watch src/index.tsx",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/react": "^18.2.0",
    "chalk": "^5.3.0",
    "immer": "^11.1.7",
    "ink": "^4.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.8.0",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.12"
  }
}
