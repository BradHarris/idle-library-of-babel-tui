{
  "name": "library-of-babel-idle",
  "version": "0.1.0",
  "description": "A browser idle/incremental game inspired by Borges' Library of Babel",
  "type": "module",
  "scripts": {
    "dev": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "preview": "vite preview --config web/vite.config.ts",
    "test": "vitest run --config web/vite.config.ts",
    "lint": "eslint web/src src",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@solidjs/diagnostics": "^2.0.3",
    "@solidjs/vite-plugin": "^3.0.1",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.8.0",
    "eslint": "^10.15.0",
    "eslint-plugin-solid": "^0.20.1",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.12",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@solidjs/web": "^2.0.3",
    "solid-js": "^2.0.3"
  }
}
